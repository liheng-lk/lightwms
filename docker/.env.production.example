# LightWMS Production Environment Variables
# 复制此文件为 .env.production 并修改配置
# Copy this file to .env.production and modify as needed

# ============================================
# Security (必须修改!)
# ============================================
# Django 密钥，请生成一个随机字符串
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============================================
# Database 数据库配置
# ============================================
POSTGRES_DB=lightwms
POSTGRES_USER=lightwms
POSTGRES_PASSWORD=your-secure-database-password

# ============================================
# Application 应用配置
# ============================================
# 允许的主机名（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS 允许的源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com

# CSRF 信任的源（逗号分隔）
CSRF_TRUSTED_ORIGINS=http://localhost,https://your-domain.com

# 是否强制 HTTPS 重定向（使用 HTTPS 时设为 True）
SECURE_SSL_REDIRECT=False

# ============================================
# Ports 端口配置
# ============================================
HTTP_PORT=80

# ============================================
# Initial Admin User 初始管理员（可选）
# ============================================
# 首次启动时创建超级用户
CREATE_SUPERUSER=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-admin-password
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com

# ============================================
# 部署说明 Deployment Instructions
# ============================================
# 1. 复制此文件: cp .env.production.example .env.production
# 2. 修改上述配置，特别是 SECRET_KEY 和数据库密码
# 3. 构建并启动:
#    docker compose -f docker-compose.production.yml build
#    docker compose -f docker-compose.production.yml up -d
# 4. 查看日志:
#    docker compose -f docker-compose.production.yml logs -f app
# 5. 启用备份服务（可选）:
#    docker compose -f docker-compose.production.yml --profile backup up -d
