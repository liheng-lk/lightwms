# LightWMS Environment Configuration
# Copy to repository root as .env and change all production secrets.

SECRET_KEY=your-super-secret-key-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

POSTGRES_DB=lightwms
POSTGRES_USER=lightwms
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Browser entry point. Access with http://<NAS-or-PC-IP>:3000 by default.
HTTP_PORT=3000

# Pin a released image version in production. Use latest only when you
# intentionally want to follow the newest published image.
LIGHTWMS_VERSION=1.2.0

# Local/LAN IP:port access normally uses plain HTTP, so keep this false.
# Set true only when the browser-facing URL is HTTPS.
SECURE_COOKIES=false

# backend is required because Next.js calls Django over the Docker network.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=False

# Only add trusted reverse-proxy networks when you intentionally deploy one.
TRUSTED_PROXY_CIDRS=

LOGIN_RATE_LIMIT_THRESHOLD=10
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_RATE_LIMIT_BLOCK_TTL=900

# Optional WeChat OAuth callback allow-list.
WECHAT_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/wechat/callback
