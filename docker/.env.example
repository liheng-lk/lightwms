# LightWMS Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# Django Settings
# =============================================================================

# SECURITY WARNING: Generate a unique secret key for production!
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-me-in-production

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.production

# Debug mode (set to False in production)
DEBUG=False

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================

POSTGRES_DB=lightwms
POSTGRES_USER=lightwms
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full database URL (alternative to individual settings)
# DATABASE_URL=postgres://lightwms:password@db:5432/lightwms

# =============================================================================
# Test Database Configuration
# =============================================================================
# For running tests with PostgreSQL (recommended):
# DATABASE_URL=postgres://lightwms:lightwms_secret@localhost:5432/lightwms_test
#
# If DATABASE_URL is not set, tests will use SQLite (limited functionality)

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security & Access Control
# =============================================================================

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Force HTTPS redirect (set to True in production with SSL)
SECURE_SSL_REDIRECT=False

# =============================================================================
# Rate Limiting
# =============================================================================

# Login rate limiting
LOGIN_RATE_LIMIT_THRESHOLD=10
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_RATE_LIMIT_BLOCK_TTL=900

# =============================================================================
# Server Ports
# =============================================================================

# HTTP port for nginx
HTTP_PORT=80

# HTTPS port for nginx (if using SSL)
HTTPS_PORT=443

# =============================================================================
# Initial Admin User (for first deployment)
# =============================================================================

# These are used by the create_superuser management command
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately
ADMIN_EMAIL=admin@example.com

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup retention (number of backups to keep)
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=12
